<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Zoom managed preferences for room nodes → /Library/Preferences/us.zoom.config.plist
  (or deliver as a Custom Settings payload for domain us.zoom.config via MDM).

  VERIFY every key against Zoom's current "Mass deploying with preconfigured settings for
  macOS" article before rollout — Zoom renames/retires keys between client releases.
  Keys at top level are enforced; keys under "Recommend" are defaults the user can change.
-->
<plist version="1.0">
<dict>
  <!-- Join computer audio automatically: no audio-choice dialog on an unattended node. -->
  <key>ZAutoJoinVoip</key><true/>
  <!-- Don't auto-update mid-event; roll client updates with node/update.zsh windows. -->
  <key>ZAutoUpdate</key><false/>
  <key>EnableSilentAutoUpdate</key><false/>
  <!-- Single-monitor layout keeps the meeting window off the shared podium display. -->
  <key>ZDualMonitorOn</key><false/>
  <key>Recommend</key>
  <dict>
    <key>ZAutoFullScreenWhenViewShare</key><false/>
    <key>ZUse720PByDefault</key><true/>
  </dict>
</dict>
</plist>
